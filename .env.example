# Server port (Railway sets this automatically in production)
PORT=3001

# Set to "production" to serve the built client from the server
NODE_ENV=development

# Feature flag: developer debug mode (multi-seat POV + minigame practice).
# Off in production unless set to "true". Automatically on outside production.
# Server-side (gates lobby:debugStart):
ENABLE_DEBUG=false
# Client-side (Vite, gates the debug bar + practice panel; must be prefixed VITE_):
VITE_ENABLE_DEBUG=false
